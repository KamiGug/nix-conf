{
  inputs,
  arch,
  gui,
  users ? null,
  root,
}:
assert (builtins.elem arch ["x86" "arm"]) || throw "arch must be one of the following 'x86', 'arm'";
assert (builtins.isBool gui) || throw "gui must be a bool value";
assert (builtins.isList users && users != [] || users == null) || throw "users needs to be a non empty list or null (for default values)";
assert (builtins.isPath root && builtins.pathExists (root + "/flake.nix")) || throw "root needs to be a path to the root of the project";
let
  lib = inputs.nixpkgs.lib;

  inherit (inputs) nixpkgs;

  systemFromArch = {
    x86 = "x86_64-linux";
    arm = "aarch64-linux";
  };
  system = systemFromArch.${arch};
  pkgs = nixpkgs.legacyPackages.${system};
  myUsers = import (lib.path.append root "users") { inherit inputs; };
  systemModules = import (lib.path.append root "system-modules");
  homeModules = import (lib.path.append root "home-modules");
  helpers = import (lib.path.append root "helpers");
  services = import (lib.path.append root "services");
  myLib = import (lib.path.append root "lib") { inherit pkgs; };

  defaultUsers =
    if gui then
      [ "peon" ]
    else
      [ "wisp" ];

  resolvedUsers =
    if users == null
      then defaultUsers
      else users;

  userSystemModules =
    map (name: myUsers.${name}.system) resolvedUsers;

  homeManagerUsers =
    builtins.listToAttrs (
      map (name: {
        name = name;
        value = myUsers.${name}.home;
      }) resolvedUsers
    );

  commonModules = [
    ./system-modules/common.nix
    ./system-modules/common-linux.nix
  ]
  ++ lib.optional gui ./system-modules/common-gui-linux.nix;

  modulesName = "nixosModules";
  sopsModule = inputs.sops-nix.${modulesName}.sops;

  homeManagerModule = inputs.home-manager.${modulesName}.home-manager;

  homeManagerConfig = {
    home-manager.useGlobalPkgs = true;
    home-manager.useUserPackages = true;

    home-manager.users = homeManagerUsers;

    home-manager.extraSpecialArgs = {
      inherit myLib;
    };

  home-manager.sharedModules =
    homeModules.common
    ++ homeModules.linux
    ++ sopsModule
    ++ lib.optional gui
      inputs.noctalia.homeModules.default
    ++ helpers;
    };

  modules =
    systemModules
    ++ services
    ++ helpers
    ++ [
      root
      commonModules
      sopsModule
      homeManagerModule
      homeManagerConfig
    ]
    ++ userSystemModules;

in
nixpkgs.lib.nixosSystem {
  inherit system modules;
  specialArgs = {
    inherit inputs systemModules homeModules myLib services;
  };
}

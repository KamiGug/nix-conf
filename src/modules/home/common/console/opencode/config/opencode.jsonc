{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    // ─────────────────────────────────────────────
    // Default: require approval for everything
    // ─────────────────────────────────────────────

    "*": "ask",

    // ─────────────────────────────────────────────
    // Reading the repository is OK
    // But never read secrets
    // (matching is last-rule-wins, denies after allow.
    // secrets.nix is source code, not a secret, so it is
    // treated like any other repo file and reads freely)
    // ─────────────────────────────────────────────

    "read": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "*.envrc.*": "deny",

      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",

      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_ecdsa*": "deny",
      "*id_dsa*": "deny",
      "*.netrc": "deny",
      "*.pgpass": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",

      "*secrets*": "deny",
      "*secrets*.nix": "allow",
      "*sops*": "deny"
    },

    "glob": "allow",
    "grep": "allow",

    // ─────────────────────────────────────────────
    // Skills checked into the repo are trusted
    // ─────────────────────────────────────────────

    "skill": "allow",

    // ─────────────────────────────────────────────
    // In-session bookkeeping and read-only helpers:
    // no filesystem or state changes.
    // ─────────────────────────────────────────────

    "todowrite": "allow",
    "question": "allow",
    "lsp": "allow",

    // ─────────────────────────────────────────────
    // Subagents: the read-only `explore` agent may be
    // launched without approval. Everything else asks
    // (the subagent's own tool calls are still gated).
    // ─────────────────────────────────────────────

    "task": {
      "explore": "allow",
      "*": "ask"
    },

    // ─────────────────────────────────────────────
    // Web access
    // ─────────────────────────────────────────────

    "webfetch": "allow",
    "websearch": "allow",

    // ─────────────────────────────────────────────
    // Every modification requires approval
    // edit covers edit/write/patch
    // ─────────────────────────────────────────────

    "edit": "ask",

    // ─────────────────────────────────────────────
    // Shell commands require approval. Matching is
    // last-rule-wins: read-only allows first, then the
    // hardening rules at the end turn anything that can
    // change state back into `ask`.
    // ─────────────────────────────────────────────

    "bash": {
      "*": "ask",

      // ─────────────────────────────────────────────
      // Read-only inspection runs without approval.
      // Risky flags, shell redirection and secret paths
      // are pulled back to `ask`/`deny` at the end.
      // ─────────────────────────────────────────────

      // listing / metadata
      "ls *": "allow",
      "tree *": "allow",
      "eza *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "dirname *": "allow",
      "basename *": "allow",

      // viewing text
      "cat *": "allow",
      "bat *": "allow",
      "batcat *": "allow",
      "tac *": "allow",
      "nl *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",

      // searching
      "grep *": "allow",
      "rg *": "allow",

      // comparing
      "diff *": "allow",
      "cmp *": "allow",
      "comm *": "allow",

      // data / binary / hashing
      "jq *": "allow",
      "hexdump *": "allow",
      "od *": "allow",
      "strings *": "allow",
      "md5sum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      "b2sum *": "allow",
      "cksum *": "allow",
      "base64 *": "allow",
      "base32 *": "allow",

      // text transforms
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "rev *": "allow",
      "column *": "allow",
      "fold *": "allow",
      "fmt *": "allow",
      "seq *": "allow",
      "expr *": "allow",

      // system / environment info
      "pwd *": "allow",
      "whoami *": "allow",
      "id *": "allow",
      "groups *": "allow",
      "uname *": "allow",
      "uptime *": "allow",
      "date *": "allow",
      "cal *": "allow",
      "printenv *": "allow",
      "locale *": "allow",
      "tty *": "allow",
      "du *": "allow",
      "df *": "allow",
      "lsblk *": "allow",
      "lsof *": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "type *": "allow",

      // misc read-only
      "echo *": "allow",
      "printf *": "allow",
      "test *": "allow",

      // Git: read-only inspection is automatic; anything that
      // changes state is never auto-approved, it asks first.
      "git *": "ask",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",

      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git fetch *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git restore *": "ask",
      "git clean *": "ask",

      // ─────────────────────────────────────────────
      // Taskfile tasks run without approval (go-task is the
      // project task runner). Must stay above the hardening
      // rules: redirections and secret paths in a `task ...`
      // command line still fall through to ask/deny below.
      // ─────────────────────────────────────────────
      "task *": "allow",

      // ─────────────────────────────────────────────
      // Hardening. MUST stay last: last matching rule wins.
      // Anything that can change state asks (never auto-runs);
      // only secret reads are denied outright.
      // ─────────────────────────────────────────────

      // Redirection: `>`/`>>`/`2>` can write files (bypassing
      // `edit: ask`) and `<`/`<<` can read arbitrary files
      // without the external_directory check. Ask first.
      // Caveat: this also catches a literal `>`/`<` in a
      // pattern, e.g. `rg '=>'`. Relax to `* >*`, `* >>*`,
      // `*2>*`, `*&>*` if that gets annoying.
      "*>*": "ask",
      "*<*": "ask",
      "*> /dev/null*": "ask",
      "*>/dev/null*": "ask",
      // Allowlisted tools that can still write/exec: ask
      "sort -o*": "ask",
      "sort * -o*": "ask",
      "sort * --output*": "ask",
      "tree -o*": "ask",
      "tree * -o*": "ask",
      "tree * --output*": "ask",
      "find * -exec*": "ask",
      "find * -execdir*": "ask",
      "find * -ok*": "ask",
      "find * -okdir*": "ask",
      "find * -delete*": "ask",
      "find * -fprint*": "ask",
      "find * -fls*": "ask",
      "fd * -x*": "ask",
      "fd * -X*": "ask",
      "fd * --exec*": "ask",
      "fd * --exec-batch*": "ask",
      "rg * --pre*": "ask",
      "bat * --pager*": "ask",
      "date -s*": "ask",
      "date * -s*": "ask",
      "date --set*": "ask",
      "date * --set*": "ask",

      // Secrets: never readable through the shell either
      // (the `read` deny does not apply to bash). These stay
      // last so nothing above can turn a secret read back on.
      // Exception: secrets.nix is source, not a secret, so
      // shell commands on it follow the normal rules: the
      // read-only viewers below run, everything else asks,
      // and redirection/exec flags re-ask at the end.
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.p12*": "deny",
      "*.pfx*": "deny",
      "*.kdbx*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_ecdsa*": "deny",
      "*id_dsa*": "deny",
      "*.netrc*": "deny",
      "*.pgpass*": "deny",
      "*.npmrc*": "deny",
      "*.pypirc*": "deny",
      "*secrets*": "deny",

      // secrets.nix: same treatment as any other file
      "*secrets.nix*": "allow",
      "cat *secrets.nix": "allow",
      "bat *secrets.nix": "allow",
      "batcat *secrets.nix": "allow",
      "head *secrets.nix": "allow",
      "tail *secrets.nix": "allow",
      "nl *secrets.nix": "allow",
      "wc *secrets.nix": "allow",
      "grep *secrets.nix": "allow",
      "rg *secrets.nix": "allow",
      "diff *secrets.nix": "allow",
      "ls *secrets.nix": "allow",
      "stat *secrets.nix": "allow",
      "git status *secrets.nix": "allow",
      "git diff *secrets.nix": "allow",
      "git log *secrets.nix": "allow",
      "git show *secrets.nix": "allow",

      // mutating flags on those viewers still ask
      "*>*": "ask",
      "*<*": "ask",
      "bat * --pager*": "ask",
      "rg * --pre*": "ask",

      "*sops*": "deny"
    },

    // ─────────────────────────────────────────────
    // Never leave the project
    // ─────────────────────────────────────────────

    "external_directory": "deny"
  },

  "agent": {
    // ─────────────────────────────────────────────
    // yolo: allow almost anything. Only secret reads and
    // anything outside the repo prompt; /tmp is exempt.
    // ─────────────────────────────────────────────

    "yolo": {
      "description": "Full-send: allow almost everything, prompt for secrets and out-of-repo access (/tmp allowed).",
      "mode": "primary",
      "permission": {
        // Override the global `*: ask`; every tool not named
        // below now runs without approval.
        "*": "allow",

        "edit": "allow",

        // Read anything, but prompt before touching secrets.
        "read": {
          "*": "allow",

          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow",
          "*.envrc": "ask",
          "*.envrc.*": "ask",

          "*.pem": "ask",
          "*.key": "ask",
          "*.p12": "ask",
          "*.pfx": "ask",
          "*.kdbx": "ask",

          "*id_rsa*": "ask",
          "*id_ed25519*": "ask",
          "*id_ecdsa*": "ask",
          "*id_dsa*": "ask",
          "*.netrc": "ask",
          "*.pgpass": "ask",
          "*.npmrc": "ask",
          "*.pypirc": "ask",

          "*secrets*": "ask",
          "*sops*": "ask"
        },

        // Run anything, but prompt before reading secrets and
        // before changing git state.
        "bash": {
          "*": "allow",

          "git add *": "ask",
          "git commit *": "ask",
          "git push *": "ask",
          "git pull *": "ask",
          "git fetch *": "ask",
          "git reset *": "ask",
          "git checkout *": "ask",
          "git switch *": "ask",
          "git restore *": "ask",
          "git clean *": "ask",

          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow",
          "*.envrc*": "ask",
          "*.pem*": "ask",
          "*.key*": "ask",
          "*.p12*": "ask",
          "*.pfx*": "ask",
          "*.kdbx*": "ask",
          "*id_rsa*": "ask",
          "*id_ed25519*": "ask",
          "*id_ecdsa*": "ask",
          "*id_dsa*": "ask",
          "*.netrc*": "ask",
          "*.pgpass*": "ask",
          "*.npmrc*": "ask",
          "*.pypirc*": "ask",
          "*secrets*": "ask",
          "*sops*": "ask"
        },

        // Anything outside the repo prompts, except /tmp.
        "external_directory": {
          "*": "ask",
          "/tmp": "allow",
          "/tmp/**": "allow"
        }
      }
    },

    // ─────────────────────────────────────────────
    // auto: like yolo, but never prompts. Secret reads
    // are denied outright (never); everything else —
    // including access outside the repo — is allowed.
    // ─────────────────────────────────────────────

    "auto": {
      "description": "No prompts: everything allowed, secret reads denied, out-of-repo access allowed.",
      "mode": "primary",
      "permission": {
        // Override the global `*: ask`; nothing prompts.
        "*": "allow",

        "edit": "allow",

        // Secrets can never be read through the read tool.
        "read": {
          "*": "allow",

          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "*.envrc": "deny",
          "*.envrc.*": "deny",

          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*.kdbx": "deny",

          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*id_dsa*": "deny",
          "*.netrc": "deny",
          "*.pgpass": "deny",
          "*.npmrc": "deny",
          "*.pypirc": "deny",

          "*secrets*": "deny",
          "*secrets*.nix": "allow",
          "*sops*": "deny"
        },

        // ...or through the shell.
        "bash": {
          "*": "allow",
          "*secrets.nix*": "allow",
          "cat *secrets.nix": "allow",
          "bat *secrets.nix": "allow",
          "head *secrets.nix": "allow",
          "tail *secrets.nix": "allow",
          "nl *secrets.nix": "allow",
          "wc *secrets.nix": "allow",
          "grep *secrets.nix": "allow",
          "rg *secrets.nix": "allow",
          "diff *secrets.nix": "allow",
          "ls *secrets.nix": "allow",
          "stat *secrets.nix": "allow",
          "git status *secrets.nix": "allow",
          "git diff *secrets.nix": "allow",
          "git log *secrets.nix": "allow",
          "git show *secrets.nix": "allow",

          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "*.envrc*": "deny",
          "*.pem*": "deny",
          "*.key*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
          "*.kdbx*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*id_dsa*": "deny",
          "*.netrc*": "deny",
          "*.pgpass*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*secrets*": "deny",

          // secrets.nix: same treatment as any other file
          "*secrets.nix*": "allow",
          "cat *secrets.nix": "allow",
          "bat *secrets.nix": "allow",
          "head *secrets.nix": "allow",
          "tail *secrets.nix": "allow",
          "nl *secrets.nix": "allow",
          "wc *secrets.nix": "allow",
          "grep *secrets.nix": "allow",
          "rg *secrets.nix": "allow",
          "diff *secrets.nix": "allow",
          "ls *secrets.nix": "allow",
          "stat *secrets.nix": "allow",
          "git status *secrets.nix": "allow",
          "git diff *secrets.nix": "allow",
          "git log *secrets.nix": "allow",
          "git show *secrets.nix": "allow",

          "*sops*": "deny"
        },

        // Leave the repo freely.
        "external_directory": "allow"
      }
    },

    // ─────────────────────────────────────────────
    // full-yolo: like auto, but secrets are fair game.
    // Nothing prompts and nothing is denied.
    // ─────────────────────────────────────────────

    "full-yolo": {
      "description": "Total full-send: everything allowed including secrets, no prompts, no denials.",
      "mode": "primary",
      "permission": {
        "*": "allow",

        "edit": "allow",
        "read": "allow",
        "bash": "allow",
        "external_directory": "allow"
      }
    },

    // ─────────────────────────────────────────────
    // build: edits allowed, read-only commands allowed,
    // everything else asks. Secrets denied, repo-only.
    // ─────────────────────────────────────────────

    "build": {
      "description": "Implementation: edits and read-only commands allowed, everything else asks.",
      "mode": "primary",
      "permission": {
        "edit": "allow"
      }
    },

    // ─────────────────────────────────────────────
    // plan: reads and read-only commands allowed, edits
    // denied. Anything outside the repo prompts except
    // /tmp. Secrets denied.
    // ─────────────────────────────────────────────

    "plan": {
      "description": "Planning: reads and read-only commands allowed, edits denied, /tmp allowed.",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow"
        },
        "external_directory": {
          "*": "ask",
          "/tmp": "allow",
          "/tmp/**": "allow"
        }
      }
    },

    "auto-plan": {
      "description": "Auto planning: read-only investigation and a step-by-step plan, nothing prompts.",
      "mode": "primary",
      "prompt": "You are an autonomous planning agent. Investigate the request using read-only tools only (read, glob, grep, list, webfetch, websearch, and the read-only explore subagent) plus read-only shell commands. Produce a concrete step-by-step plan referencing exact files, locations and commands. Never modify files and never run state-changing commands: if a step would require a write or a state change, describe it in the plan instead of doing it. If a tool you need is blocked, skip it, note the gap in the plan, and continue — do not ask for permission.",
      "permission": {
        "*": "allow",
        "doom_loop": "allow",
        "edit": "deny",
        "task": {
          "explore": "allow",
          "*": "deny"
        },
        "read": {
          "*": "allow",

          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "*.envrc": "deny",
          "*.envrc.*": "deny",

          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*.kdbx": "deny",

          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*id_dsa*": "deny",
          "*.netrc": "deny",
          "*.pgpass": "deny",
          "*.npmrc": "deny",
          "*.pypirc": "deny",

          "*secrets*": "deny",
          "*secrets*.nix": "allow",
          "*sops*": "deny"
        },
        "bash": {
          "*": "deny",

          "ls *": "allow",
          "tree *": "allow",
          "eza *": "allow",
          "fd *": "allow",
          "find *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "realpath *": "allow",
          "readlink *": "allow",
          "dirname *": "allow",
          "basename *": "allow",

          "cat *": "allow",
          "bat *": "allow",
          "batcat *": "allow",
          "tac *": "allow",
          "nl *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",

          "grep *": "allow",
          "rg *": "allow",

          "diff *": "allow",
          "cmp *": "allow",
          "comm *": "allow",

          "jq *": "allow",
          "hexdump *": "allow",
          "od *": "allow",
          "strings *": "allow",
          "md5sum *": "allow",
          "sha1sum *": "allow",
          "sha256sum *": "allow",
          "sha512sum *": "allow",
          "b2sum *": "allow",
          "cksum *": "allow",
          "base64 *": "allow",
          "base32 *": "allow",

          "sort *": "allow",
          "uniq *": "allow",
          "cut *": "allow",
          "tr *": "allow",
          "rev *": "allow",
          "column *": "allow",
          "fold *": "allow",
          "fmt *": "allow",
          "seq *": "allow",
          "expr *": "allow",

          "pwd *": "allow",
          "whoami *": "allow",
          "id *": "allow",
          "groups *": "allow",
          "uname *": "allow",
          "uptime *": "allow",
          "date *": "allow",
          "cal *": "allow",
          "printenv *": "allow",
          "locale *": "allow",
          "tty *": "allow",
          "du *": "allow",
          "df *": "allow",
          "lsblk *": "allow",
          "lsof *": "allow",
          "which *": "allow",
          "whereis *": "allow",
          "type *": "allow",

          "echo *": "allow",
          "printf *": "allow",
          "test *": "allow",

          "git *": "deny",

          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",

          "git add *": "deny",
          "git commit *": "deny",
          "git push *": "deny",
          "git pull *": "deny",
          "git fetch *": "deny",
          "git reset *": "deny",
          "git checkout *": "deny",
          "git switch *": "deny",
          "git restore *": "deny",
          "git clean *": "deny",

          "task *": "deny",

          "*>*": "deny",
          "*<*": "deny",
          "*> /dev/null*": "deny",
          "*>/dev/null*": "deny",
          "sort -o*": "deny",
          "sort * -o*": "deny",
          "sort * --output*": "deny",
          "tree -o*": "deny",
          "tree * -o*": "deny",
          "tree * --output*": "deny",
          "find * -exec*": "deny",
          "find * -execdir*": "deny",
          "find * -ok*": "deny",
          "find * -okdir*": "deny",
          "find * -delete*": "deny",
          "find * -fprint*": "deny",
          "find * -fls*": "deny",
          "fd * -x*": "deny",
          "fd * -X*": "deny",
          "fd * --exec*": "deny",
          "fd * --exec-batch*": "deny",
          "rg * --pre*": "deny",
          "bat * --pager*": "deny",
          "date -s*": "deny",
          "date * -s*": "deny",
          "date --set*": "deny",
          "date * --set*": "deny",

          "*.env": "deny",
          "*.env.*": "deny",
          "*.envrc*": "deny",
          "*.pem*": "deny",
          "*.key*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
          "*.kdbx*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*id_dsa*": "deny",
          "*.netrc*": "deny",
          "*.pgpass*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*secrets*": "deny",

          // secrets.nix: same treatment as any other file.
          // Reads run, writes are denied (this agent never writes),
          // redirection/exec flags below re-deny.
          "*secrets.nix*": "allow",
          "cat *secrets.nix": "allow",
          "bat *secrets.nix": "allow",
          "batcat *secrets.nix": "allow",
          "head *secrets.nix": "allow",
          "tail *secrets.nix": "allow",
          "nl *secrets.nix": "allow",
          "wc *secrets.nix": "allow",
          "grep *secrets.nix": "allow",
          "rg *secrets.nix": "allow",
          "diff *secrets.nix": "allow",
          "ls *secrets.nix": "allow",
          "stat *secrets.nix": "allow",
          "git status *secrets.nix": "allow",

services:
  {{ fullName }}:
    container_name: {{ fullName }}
    image: localhost/{{ fullName }}:latest
    restart: unless-stopped
    environment:
      FORGEJO__server__SSH_DOMAIN: "{{ fullName }}.{{ domain }}"
      FORGEJO__server__ROOT_URL: "{{ protocol }}://{{ fullName }}.{{ domain }}"
      FORGEJO__database__DB_TYPE: postgres
      FORGEJO__database__HOST: "{{ postgres_host | default("postgres") }}:{{ postgres_port | default(5432) }}"
      FORGEJO__database__NAME: "{{ fullName }}"
      FORGEJO__database__USER: "{{ fullName }}"
      FORGEJO__database__PASSWD: "${FORGEJO__database__PASSWD:?database password required}"
    volumes:
      - "{{ root }}/{{ fullName }}/data:/data"
{% if networks %}
    networks:
{% for network in networks %}
      - "app-service-{{ network }}{{ postfix }}"
{% endfor %}
{% else %}
    networks: []
{% endif %}

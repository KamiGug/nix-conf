{
  "helix_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 13.5,
  "format_on_save": "off",
  "load_direnv": "shell_hook",
  "terminal": {
    "shell": "system",
    "working_directory": "current_project_directory"
  },
  "project_panel": {
    "dock": "left"
  },
  "auto_install_extensions": {
    "nix": true,
    "toml": true,
    "kdl": true,
    "sops": true,
    "vue": true,
    "taskfile": true
  },
  "lsp": {{ lsp | tojson }},
  "languages": {{ languages | tojson }}
}

{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    // ─────────────────────────────────────────────
    // Default: require approval for everything
    // ─────────────────────────────────────────────

    "*": "ask",

    // ─────────────────────────────────────────────
    // Reading the repository is OK
    // But never read secrets
    // (matching is last-rule-wins, denies after allow)
    // ─────────────────────────────────────────────

    "read": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "*.envrc.*": "deny",

      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",

      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_ecdsa*": "deny",
      "*id_dsa*": "deny",
      "*.netrc": "deny",
      "*.pgpass": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",

      "*secrets*": "deny",
      "*sops*": "deny"
    },

    "glob": "allow",
    "grep": "allow",

    // ─────────────────────────────────────────────
    // Skills checked into the repo are trusted
    // ─────────────────────────────────────────────

    "skill": "allow",

    // ─────────────────────────────────────────────
    // Web access
    // ─────────────────────────────────────────────

    "webfetch": "allow",

    // ─────────────────────────────────────────────
    // Every modification requires approval
    // edit covers edit/write/patch
    // ─────────────────────────────────────────────

    "edit": "ask",

    // ─────────────────────────────────────────────
    // Shell commands require approval. Matching is
    // last-rule-wins: read-only allows first, then the
    // hardening rules at the end turn anything that can
    // change state back into `ask`.
    // ─────────────────────────────────────────────

    "bash": {
      "*": "ask",

      // ─────────────────────────────────────────────
      // Read-only inspection runs without approval.
      // Risky flags, shell redirection and secret paths
      // are pulled back to `ask`/`deny` at the end.
      // ─────────────────────────────────────────────

      // listing / metadata
      "ls *": "allow",
      "tree *": "allow",
      "eza *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "dirname *": "allow",
      "basename *": "allow",

      // viewing text
      "cat *": "allow",
      "bat *": "allow",
      "batcat *": "allow",
      "tac *": "allow",
      "nl *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",

      // searching
      "grep *": "allow",
      "rg *": "allow",

      // comparing
      "diff *": "allow",
      "cmp *": "allow",
      "comm *": "allow",

      // data / binary / hashing
      "jq *": "allow",
      "hexdump *": "allow",
      "od *": "allow",
      "strings *": "allow",
      "md5sum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      "b2sum *": "allow",
      "cksum *": "allow",
      "base64 *": "allow",
      "base32 *": "allow",

      // text transforms
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "rev *": "allow",
      "column *": "allow",
      "fold *": "allow",
      "fmt *": "allow",
      "seq *": "allow",
      "expr *": "allow",

      // system / environment info
      "pwd *": "allow",
      "whoami *": "allow",
      "id *": "allow",
      "groups *": "allow",
      "uname *": "allow",
      "uptime *": "allow",
      "date *": "allow",
      "cal *": "allow",
      "printenv *": "allow",
      "locale *": "allow",
      "tty *": "allow",
      "du *": "allow",
      "df *": "allow",
      "lsblk *": "allow",
      "lsof *": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "type *": "allow",

      // misc read-only
      "echo *": "allow",
      "printf *": "allow",
      "test *": "allow",

      // Git: read-only inspection is automatic; anything that
      // changes state is never auto-approved, it asks first.
      "git *": "ask",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",

      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git fetch *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git restore *": "ask",
      "git clean *": "ask",

      // ─────────────────────────────────────────────
      // Hardening. MUST stay last: last matching rule wins.
      // Anything that can change state asks (never auto-runs);
      // only secret reads are denied outright.
      // ─────────────────────────────────────────────

      // Redirection: `>`/`>>`/`2>` can write files (bypassing
      // `edit: ask`) and `<`/`<<` can read arbitrary files
      // without the external_directory check. Ask first.
      // Caveat: this also catches a literal `>`/`<` in a
      // pattern, e.g. `rg '=>'`. Relax to `* >*`, `* >>*`,
      // `*2>*`, `*&>*` if that gets annoying.
      "*>*": "ask",
      "*<*": "ask",

      // Allowlisted tools that can still write/exec: ask
      "sort -o*": "ask",
      "sort * -o*": "ask",
      "sort * --output*": "ask",
      "tree -o*": "ask",
      "tree * -o*": "ask",
      "tree * --output*": "ask",
      "find * -exec*": "ask",
      "find * -execdir*": "ask",
      "find * -ok*": "ask",
      "find * -okdir*": "ask",
      "find * -delete*": "ask",
      "find * -fprint*": "ask",
      "find * -fls*": "ask",
      "fd * -x*": "ask",
      "fd * -X*": "ask",
      "fd * --exec*": "ask",
      "fd * --exec-batch*": "ask",
      "rg * --pre*": "ask",
      "bat * --pager*": "ask",
      "date -s*": "ask",
      "date * -s*": "ask",
      "date --set*": "ask",
      "date * --set*": "ask",

      // Secrets: never readable through the shell either
      // (the `read` deny does not apply to bash). These stay
      // last so nothing above can turn a secret read back on.
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.p12*": "deny",
      "*.pfx*": "deny",
      "*.kdbx*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_ecdsa*": "deny",
      "*id_dsa*": "deny",
      "*.netrc*": "deny",
      "*.pgpass*": "deny",
      "*.npmrc*": "deny",
      "*.pypirc*": "deny",
      "*secrets*": "deny",
      "*sops*": "deny"
    },

    // ─────────────────────────────────────────────
    // Never leave the project
    // ─────────────────────────────────────────────

    "external_directory": "deny"
  }
}

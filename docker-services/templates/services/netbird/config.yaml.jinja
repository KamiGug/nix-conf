{% set service = services.netbird %}{% if service is defined and service.enable %}
{% set port = service.port | default({}) %}
{% set fqdn = service.host ~ '.' ~ domain %}
{% if service.proxy is defined and service.proxy.enable %}
{% set public_url = protocol ~ '://' ~ fqdn %}
{% else %}
{% set public_url = 'http://' ~ fqdn ~ ':' ~ (port.api | default(8081)) %}
{% endif %}
# Generated by Jinja2. DO NOT EDIT MANUALLY.
#
# Configuration for the NetBird combined server (management, signal, relay, STUN).
# Only settings the container cannot read from its environment live here, the
# postgres DSN is injected as NB_STORE_ENGINE_POSTGRES_DSN from .env.
server:
  # Plain HTTP inside the container, TLS is terminated by the reverse proxy.
  listenAddress: ":80"

  # Public address handed out to peers. Includes the port unless proxied.
  exposedAddress: "{{ public_url }}"

  stunPorts:
    - {{ port.stun | default(3478) }}

  logLevel: info
  logFile: console
  dataDir: "/var/lib/netbird/"

  # Shared secret for the embedded relay, peers are handed relay credentials.
  authSecret: "{{ service.auth_secret }}"

  # Embedded IdP (Dex) serving the dashboard and the CLI.
  auth:
    issuer: "{{ public_url }}/oauth2"
    dashboardRedirectURIs:
      - "{{ public_url }}/nb-auth"
      - "{{ public_url }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"
{% if service.owner is defined and service.owner.email %}
    # Bootstrapped on first start only.
    owner:
      email: "{{ service.owner.email }}"
      password: "{{ service.owner.pass }}"
{% endif %}

  store:
    engine: {% if service.postgres is defined and service.postgres.enable %}postgres{% else %}sqlite{% endif %}
    # Encrypts setup keys, API tokens and other secrets at rest. Keep it
    # backed up: losing it means losing every stored secret.
    encryptionKey: "{{ service.store_encryption_key }}"
{% endif %}

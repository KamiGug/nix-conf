{% set service = services.postgres %}{% if service is defined and service.enable %}{% set postgres_major = service.tag.split('-')[0].split('.')[0] | int %}
services:
  {{ service.host }}:
    container_name: {{ service.host }}
    image: {{ service.image }}:{{ service.tag }}
    restart: unless-stopped

    environment:
      - POSTGRES_USER={{ service.user }}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

    volumes:
      - type: bind
        source: {{ base_mount_dir }}/{{ service.host }}/data
        target: /var/lib/postgresql{% if postgres_major < 18 %}/data{% endif %}
      - type: bind
        source: /etc/localtime
        target: /etc/localtime
        read_only: true

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 10s

{% if service.port is defined and service.port is not false %}
    ports:
      - "{{ service.port }}:5432"
{% endif %}
{% endif %}

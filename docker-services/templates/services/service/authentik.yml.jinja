{% set service = services.authentik %}{% if service is defined and service.enable %}
services:
  {{service.host}}-server:
    command: server
    container_name: {{ service.host }}-server
    {% if services.postgres is defined %}
    depends_on:
      {{ services.postgres.host }}:
        condition: service_healthy
    {% endif %}
    networks:
      default:
        # nginx.conf.jinja builds the upstream from `host` + `proxy.port`, so the
        # alias keeps `auth:9000` resolvable now that the service is named
        # `auth-server`. Without it nginx refuses to start with
        # "host not found in upstream" and takes every vhost down with it.
        aliases:
          - {{ service.host }}
    # No env_file here: it would inject every other service's secrets from
    # .env into these containers. Everything authentik needs is listed below.
    environment:
      AUTHENTIK_POSTGRESQL__HOST: {{ service.postgres.url }}
      AUTHENTIK_POSTGRESQL__PORT: {{ service.postgres.port }}
      AUTHENTIK_POSTGRESQL__NAME: {{ service.host }}
      AUTHENTIK_POSTGRESQL__USER: {{ service.postgres.user }}
      AUTHENTIK_POSTGRESQL__PASSWORD: ${AUTHENTIK_DB_PASSWORD}
      AUTHENTIK_SECRET_KEY: ${AUTHENTIK_SECRET_KEY:?secret key required}
    image: {{ service.image.server }}:{{ service.tag.server }}
    restart: unless-stopped
    shm_size: 512mb

    healthcheck:
      # `ak` ships with the image, no curl/wget in this base image.
      test: ["CMD", "ak", "healthcheck", "server"]
      interval: 30s
      timeout: 30s
      retries: 5
      start_period: 90s

{% if service.port is defined and service.port is not false %}
    ports:
      - "{{ service.port }}:9000"
{% endif %}
    volumes:
      - type: bind
        source: {{ base_mount_dir }}/{{ service.host }}/data
        target: /data
      - type: bind
        source: {{ base_mount_dir }}/{{ service.host }}/custom-templates
        target: /templates

  {{service.host}}-worker:
    container_name: {{ service.host }}-worker
    command: worker
    depends_on:
      {{ services.postgres.host }}:
        condition: service_healthy
    environment:
      AUTHENTIK_POSTGRESQL__HOST: {{ service.postgres.url }}
      AUTHENTIK_POSTGRESQL__PORT: {{ service.postgres.port }}
      AUTHENTIK_POSTGRESQL__NAME: {{ service.host }}
      AUTHENTIK_POSTGRESQL__USER: {{ service.postgres.user }}
      AUTHENTIK_POSTGRESQL__PASSWORD: ${AUTHENTIK_DB_PASSWORD}
      AUTHENTIK_SECRET_KEY: ${AUTHENTIK_SECRET_KEY:?secret key required}
    image: {{ service.image.worker }}:{{ service.tag.worker }}
    restart: unless-stopped
    shm_size: 512mb
    user: root

    healthcheck:
      test: ["CMD", "ak", "healthcheck", "worker"]
      interval: 30s
      timeout: 30s
      retries: 5
      start_period: 90s

    volumes:
      # - /var/run/docker.sock:/var/run/docker.sock
      - type: bind
        source: {{ base_mount_dir }}/{{ service.host }}/data
        target: /data
      - type: bind
        source: {{ base_mount_dir }}/{{ service.host }}/certs
        target: /certs
      - type: bind
        source: {{ base_mount_dir }}/{{ service.host }}/custom-templates
        target: /templates
{% endif %}

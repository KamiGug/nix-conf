{% set service = services.wiki %}{% if service is defined and service.enable -%}
#!/usr/bin/env bash
#
# Generated from templates/services/mediawiki/setup.sh.jinja. DO NOT EDIT.
#
# Container entrypoint for MediaWiki. The official image ships no entrypoint at
# all, so this one:
#
#   1. writes the secrets MediaWiki cannot start without (once),
#   2. waits for PostgreSQL,
#   3. installs the wiki while the database is still empty and updates it
#      afterwards,
#   4. hands over to Apache.
#
# Everything it needs comes from the container environment, see
# templates/services/service/wiki.yml.jinja.

set -euo pipefail

IP=/var/www/html
DATA_DIR=/var/lib/mediawiki
WIKI_USER=www-data

log() {
	printf '[mediawiki] %s\n' "$*"
}

as_wiki_user() {
	runuser -u "$WIKI_USER" -- "$@"
}

install -d -o "$WIKI_USER" -g "$WIKI_USER" -m 0755 "$DATA_DIR"

# The images bind mount masks whatever the image ships, and the container runtime
# creates a missing host source directory as root, which www-data cannot write to.
# Without this every upload and thumbnail fails. Needs root, which the image
# expects (see the user: note in templates/services/service/wiki.yml.jinja), so
# warn instead of failing when the container was pinned to another user.
if [ "$(id -u)" -eq 0 ]; then
	install -d -o "$WIKI_USER" -g "$WIKI_USER" -m 0755 "$IP/images"
else
	log "not running as root, cannot own $IP/images: uploads may fail"
fi

# $wgSecretKey and $wgPasswordSecret sign cookies, sessions and tokens. MediaWiki
# cannot regenerate them without invalidating all of them, so they are written
# once and kept in the data volume. LocalSettings.php reads them from here.
if [ ! -s "$DATA_DIR/secrets.php" ]; then
	log "generating $DATA_DIR/secrets.php"
	MW_SECRETS_FILE="$DATA_DIR/secrets.php" php <<'PHP'
<?php
$contents = "<?php\n# Generated by the MediaWiki container entrypoint. Do not delete.\n";
foreach ( [ 'wgSecretKey', 'wgPasswordSecret' ] as $name ) {
	$contents .= '$' . $name . " = '" . bin2hex( random_bytes( 32 ) ) . "';\n";
}
file_put_contents( getenv( 'MW_SECRETS_FILE' ), $contents );
PHP
	chown "$WIKI_USER:$WIKI_USER" "$DATA_DIR/secrets.php"
	chmod 0640 "$DATA_DIR/secrets.php"
fi

# Without a configured admin password the wiki still needs one to log in with,
# so generate it once and keep it next to the secrets: install.php only reads it
# on the first start, after that the container log is the only place left to
# look.
MW_ADMIN_USER="${MW_ADMIN_USER:-Admin}"
if [ -z "${MW_ADMIN_PASSWORD:-}" ]; then
	if [ -s "$DATA_DIR/admin-password" ]; then
		MW_ADMIN_PASSWORD="$(cat "$DATA_DIR/admin-password")"
	else
		MW_ADMIN_PASSWORD="$(php -r 'echo bin2hex( random_bytes( 12 ) );')"
		printf '%s' "$MW_ADMIN_PASSWORD" > "$DATA_DIR/admin-password"
		chown "$WIKI_USER:$WIKI_USER" "$DATA_DIR/admin-password"
		chmod 0600 "$DATA_DIR/admin-password"
		log "no admin password configured, generated one for user '${MW_ADMIN_USER}': ${MW_ADMIN_PASSWORD}"
	fi
fi

# depends_on already waits for PostgreSQL to be healthy. This covers the case
# where PostgreSQL is still starting up while the wiki container restarts.
log "waiting for PostgreSQL at ${MW_DB_HOST}:${MW_DB_PORT}"
for _ in $(seq 60); do
	if php -r '$s = @fsockopen( getenv( "MW_DB_HOST" ), (int)getenv( "MW_DB_PORT" ), $errno, $errstr, 2 ); exit( $s ? 0 : 1 );'; then
		break
	fi
	sleep 1
done

# MediaWiki is installed when its tables are there. Asking the database instead
# of a marker file in the data volume keeps this correct after a restore, a
# dropped database or a MediaWiki upgrade.
#
# Prints "installed" or "empty" and exits 2 when the database cannot be read.
# install.php drops whatever a database contains, so a database that cannot be
# inspected must not look empty.
read_wiki_state() {
	as_wiki_user php <<'PHP'
<?php
// The pgsql extension is what MediaWiki itself uses, pdo_pgsql is not
// installed in the image.
$connection = @pg_connect( sprintf(
	'host=%s port=%s dbname=%s user=%s password=%s',
	getenv( 'MW_DB_HOST' ),
	getenv( 'MW_DB_PORT' ),
	getenv( 'MW_DB_NAME' ),
	getenv( 'MW_DB_USER' ),
	getenv( 'MW_DB_PASSWORD' )
) );
if ( $connection === false ) {
	exit( 2 );
}

$result = pg_query( $connection, sprintf(
	// pg_catalog is readable by everyone, unlike information_schema.
	'SELECT EXISTS ( SELECT 1 FROM pg_class AS c JOIN pg_namespace AS n ON n.oid = c.relnamespace' .
	' WHERE c.relname = %s AND n.nspname = %s )',
	pg_escape_literal( $connection, 'page' ),
	pg_escape_literal( $connection, getenv( 'MW_DB_SCHEMA' ) )
) );
if ( $result === false ) {
	exit( 2 );
}

echo pg_fetch_result( $result, 0, 0 ) === 't' ? 'installed' : 'empty';
PHP
}

wiki_state="$(read_wiki_state)" || wiki_state="unreadable"

case "$wiki_state" in
installed)
	log "database already holds a wiki, only running update.php"
	;;
empty)
	log "installing wiki '${MW_SITENAME}' with admin '${MW_ADMIN_USER}'"

	# install.php takes the passwords from files, otherwise they show up in ps
	# for every user inside the container. The directory has to be owned by
	# www-data because the maintenance script runs as www-data.
	secrets="$DATA_DIR/setup"
	install -d -o "$WIKI_USER" -g "$WIKI_USER" -m 0700 "$secrets"
	touch "$secrets/dbpass" "$secrets/adminpass"
	chown "$WIKI_USER:$WIKI_USER" "$secrets/dbpass" "$secrets/adminpass"
	chmod 0600 "$secrets/dbpass" "$secrets/adminpass"
	printf '%s' "$MW_DB_PASSWORD" > "$secrets/dbpass"
	printf '%s' "$MW_ADMIN_PASSWORD" > "$secrets/adminpass"

	# install.php refuses to run when it finds a LocalSettings.php ("an existing
	# installation has been detected"), and MW_CONFIG_FILE points at the one
	# mounted into this container. An empty value makes it fall back to
	# $IP/LocalSettings.php, which does not exist, so the installer sees an empty
	# installation and writes its own LocalSettings.php into --confpath, where it
	# is thrown away.
	as_wiki_user env MW_CONFIG_FILE= php "$IP/maintenance/run.php" install \
		"$MW_SITENAME" "$MW_ADMIN_USER" \
		--confpath "$secrets" \
		--lang "$MW_LANG" \
		--scriptpath "" \
		--dbtype "${MW_DB_TYPE:-postgres}" \
		--dbserver "$MW_DB_HOST" \
		--dbport "$MW_DB_PORT" \
		--dbname "$MW_DB_NAME" \
		--dbschema "$MW_DB_SCHEMA" \
		--dbuser "$MW_DB_USER" \
		--dbpassfile "$secrets/dbpass" \
		--passfile "$secrets/adminpass"

	rm -rf "$secrets"
	;;
*)
	log "cannot read the database, not running install.php because it drops the tables of an existing wiki"
	exit 1
	;;
esac

# Runs on every start, so an image or extension update brings the database
# along. It is a no-op when the schema is already current.
log "running update.php"
as_wiki_user php "$IP/maintenance/run.php" update

log "starting apache"
if [ "$#" -gt 0 ]; then
	exec "$@"
fi
exec apache2-foreground
{% endif %}

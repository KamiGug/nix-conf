{#- Values are double quoted so `#`, spaces and `$` survive dotenv parsing.
    The `-%}` on the block tags keeps the generated file free of blank lines.
-#}
{%- macro envv(value) -%}
{{- value | string | replace("\\", "\\\\") | replace('"', '\\"') -}}
{%- endmacro -%}
{%- if services.forgejo is defined and services.forgejo.enable -%}
FORGEJO_DB_PASSWORD="{{ envv(services.forgejo.postgres.pass) }}"
{% endif -%}
{%- if services.nextcloud is defined and services.nextcloud.enable -%}
NEXTCLOUD_DB_PASSWORD="{{ envv(services.nextcloud.postgres.pass) }}"
{% endif -%}
{%- if services.euro_office is defined and services.euro_office.enable -%}
EURO_OFFICE_JWT_SECRET="{{ envv(services.euro_office.jwt_secret) }}"
{% endif -%}
{%- if services.authentik is defined and services.authentik.enable -%}
AUTHENTIK_DB_PASSWORD="{{ envv(services.authentik.postgres.pass) }}"
AUTHENTIK_SECRET_KEY="{{ envv(services.authentik.secret_key) }}"
{% endif -%}
{%- if services.netbird is defined and services.netbird.enable -%}
NETBIRD_DB_PASSWORD="{{ envv(services.netbird.postgres.pass) }}"
{% endif -%}
{%- if services.wiki is defined and services.wiki.enable -%}
WIKI_DB_PASSWORD="{{ envv(services.wiki.postgres.pass) }}"
{% if services.wiki.admin is defined and services.wiki.admin.pass is defined -%}
WIKI_ADMIN_PASSWORD="{{ envv(services.wiki.admin.pass) }}"
{% endif -%}
{% if services.wiki.oidc is defined and services.wiki.oidc.enable | default(false) and services.wiki.oidc.client_secret is defined -%}
WIKI_OIDC_CLIENT_SECRET="{{ envv(services.wiki.oidc.client_secret) }}"
{% endif -%}
{% endif -%}
{%- if services.postgres is defined and services.postgres.enable -%}
POSTGRES_PASSWORD="{{ envv(services.postgres.pass) }}"
{% endif -%}

{% if services.forgejo is defined and services.forgejo.enable %}
FORGEJO_DB_PASSWORD={{ services.forgejo.postgres.pass }}
{% endif %}
{% if services.nextcloud is defined and services.nextcloud.enable %}
NEXTCLOUD_DB_PASSWORD={{ services.nextcloud.postgres.pass }}
{% endif %}
{% if services.euro_office is defined and services.euro_office.enable %}
EURO_OFFICE_JWT_SECRET={{ services.euro_office.jwt_secret }}
{% endif %}
{% if services.authentik is defined and services.authentik.enable %}
AUTHENTIK_DB_PASSWORD={{ services.authentik.postgres.pass }}
AUTHENTIK_SECRET_KEY={{ services.authentik.secret_key }}
{% endif %}
{% if services.netbird is defined and services.netbird.enable %}
NETBIRD_DB_PASSWORD={{ services.netbird.postgres.pass }}
{% endif %}
{% if services.postgres is defined and services.postgres.enable %}
POSTGRES_PASSWORD={{ services.postgres.pass }}
{% endif %}

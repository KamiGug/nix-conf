    {% set dns_resolver = proxy_cfg.dns_resolver if proxy_cfg.dns_resolver is defined else dns_resolver %}
    {% if dns_resolver is defined and dns_resolver %}
    resolver {{ dns_resolver }};
    resolver_timeout 5s;
    {% endif %}

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # -----------------------------------------------------------------
    # General HTTP hardening
    # -----------------------------------------------------------------

    server_tokens off;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    keepalive_timeout 65;
    types_hash_max_size 4096;

    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 30s;

    client_body_buffer_size 16k;
    client_header_buffer_size 4k;
    large_client_header_buffers 2 4k;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;


    {% for name, service in services.items() if service.enable | default(false) %}
    {% if service.proxy is defined and service.proxy.enable | default(false) %}

    {% set upstream_port = service.proxy.port | default(80) %}

    {% if service.proxy.ip is defined and service.proxy.ip is not false %}
    {% set upstream = service.proxy.ip %}
    {% else %}
    {% set upstream = service.host ~ ':' ~ upstream_port %}
    {% endif %}

    {% set fqdn = service.host ~ '.' ~ domain %}


    {% if protocol == "http" %}

    # ================================================================
    # {{ name }} - HTTP
    # ================================================================

    server {
        listen 80;
        listen [::]:80;

        server_name {{ fqdn }};


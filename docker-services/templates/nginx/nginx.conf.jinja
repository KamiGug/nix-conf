        # Proxy
        # ------------------------------------------------------------

        location / {
            {% if dns_resolver is defined and dns_resolver %}
            # No URI part, so nginx passes the original request URI through.
            set $upstream_{{ name }} {{ upstream }};
            proxy_pass http://$upstream_{{ name }};
            {% else %}
            proxy_pass http://{{ upstream }};
            {% endif %}

            # Preserve original request information.
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            # Remove incoming Proxy header.
            proxy_set_header Proxy "";

            # HTTP/1.1 is useful for keep-alive and WebSockets.
            proxy_http_version 1.1;

            # Do not send hop-by-hop Connection header by default.
            proxy_set_header Connection "";


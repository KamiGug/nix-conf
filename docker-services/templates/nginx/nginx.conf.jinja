        {% set hsts = proxy.security.hsts if proxy is defined and proxy.security is defined and proxy.security.hsts is defined else security.hsts %}
        {% set hsts_max_age = proxy.security.hsts_max_age if proxy is defined and proxy.security is defined and proxy.security.hsts_max_age is defined else security.hsts_max_age %}
        {% set hsts_include_subdomains = proxy.security.hsts_include_subdomains if proxy is defined and proxy.security is defined and proxy.security.hsts_include_subdomains is defined else security.hsts_include_subdomains %}

            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header X-Permitted-Cross-Domain-Policies "none" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss:;" always;

            {% set proxy_cfg = proxy if proxy is defined else {} %}
            {% set hsts = proxy_cfg.security.hsts if proxy_cfg.security is defined and proxy_cfg.security.hsts is defined else security.hsts %}
            {% set hsts_max_age = proxy_cfg.security.hsts_max_age if proxy_cfg.security is defined and proxy_cfg.security.hsts_max_age is defined else security.hsts_max_age %}
            {% set hsts_include_subdomains = proxy_cfg.security.hsts_include_subdomains if proxy_cfg.security is defined and proxy_cfg.security.hsts_include_subdomains is defined else security.hsts_include_subdomains %}

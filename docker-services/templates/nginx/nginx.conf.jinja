    # Rate limiting
    # -----------------------------------------------------------------
    {% set proxy_cfg = proxy if proxy is defined else {} %}
    limit_req_zone $binary_remote_addr zone=req_limit_per_ip:10m rate={{ proxy_cfg.rate_limit | default(10) }}r/s;
    limit_conn_zone $binary_remote_addr zone=conn_limit_per_ip:10m;


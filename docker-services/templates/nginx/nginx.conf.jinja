            # Rate limiting
            # --------------------------------------------------------

            limit_req zone=req_limit_per_ip burst={{ proxy_cfg.rate_limit_burst | default(20) }} nodelay;
            limit_conn conn_limit_per_ip {{ proxy_cfg.max_connections_per_ip | default(20) }};


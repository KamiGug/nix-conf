        add_header Strict-Transport-Security
            "max-age={{ hsts_max_age | default(31536000) }}{% if hsts_include_subdomains | default(true) %}; includeSubDomains{% endif %}"
            always;
        {% endif %}

        {% set permissions_policy = service.proxy.permissions_policy | default((proxy.security.permissions_policy if proxy is defined and proxy.security is defined else security.permissions_policy) | default(true)) %}
        {% if permissions_policy %}
        add_header Permissions-Policy
            "{{ permissions_policy if permissions_policy is string else 'accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()' }}"
            always;
        {% endif %}


        # ------------------------------------------------------------
        # Proxy
        # ------------------------------------------------------------

        location / {
            # Backend services are HTTP.
            {% if dns_resolver is defined and dns_resolver %}
            # No URI part, so nginx passes the original request URI through.
            set $upstream_{{ name }} {{ upstream }};
            proxy_pass http://$upstream_{{ name }};
            {% else %}

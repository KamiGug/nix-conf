            # WebSockets
            # --------------------------------------------------------

            {% if service.proxy.websocket | default(false) %}
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            {% endif %}

            # --------------------------------------------------------
            # Request size
            # --------------------------------------------------------

            client_max_body_size {{ service.proxy.max_body_size | default("100m") }};

            # --------------------------------------------------------
            # Timeouts
            # --------------------------------------------------------

            proxy_connect_timeout {{ service.proxy.connect_timeout | default("10s") }};
            proxy_send_timeout {{ service.proxy.send_timeout | default("60s") }};
            proxy_read_timeout {{ service.proxy.read_timeout | default("60s") }};

            # --------------------------------------------------------
            # Request buffering
            # --------------------------------------------------------

            {% if service.proxy.request_buffering | default(true) %}
            proxy_request_buffering on;
            {% else %}
            proxy_request_buffering off;
            {% endif %}
        }
    }


